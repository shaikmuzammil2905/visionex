# THE VISIONEX - Environment Configuration Template
# Copy this file to `.env` and fill in your actual production credentials.

# -------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION
# -------------------------------------------------------------
# Found in your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# -------------------------------------------------------------
# GOOGLE ANALYTICS 4 (GA4)
# -------------------------------------------------------------
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -------------------------------------------------------------
# GOOGLE SEARCH CONSOLE
# -------------------------------------------------------------
# Content value from your Google Search Console HTML meta tag verification
VITE_GSC_VERIFICATION_CODE=your_google_search_console_verification_code

# -------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay / Cashfree / Stripe India)
# -------------------------------------------------------------
# Public Key for checkout integration
VITE_PAYMENT_KEY_ID=rzp_live_your_key_id_here
VITE_PAYMENT_CURRENCY=INR

# -------------------------------------------------------------
# CONTACT & NOTIFICATIONS
# -------------------------------------------------------------
VITE_SUPPORT_PHONE=9652553433
VITE_SUPPORT_WHATSAPP=7013429578
VITE_SUPPORT_EMAIL=contact@thevisionex.com
VITE_SITE_URL=https://thevisionex.com
